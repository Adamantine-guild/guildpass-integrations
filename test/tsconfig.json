{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "allowJs": true,
    "noEmit": false,
    "outDir": "../test-dist",
    "rootDir": "..",
    "incremental": false,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"]
  },
  "include": [
    "../lib/utils.ts",
    "../components/ui/skeleton.tsx",
    "../components/ui/card.tsx",
    "../components/dashboard/membership-card-skeleton.tsx",
    "../lib/api/mappers.ts",
    "../lib/api/optimistic.ts",
    "../lib/api/types.ts",
    "../lib/api/access-decision.ts",
    "../lib/rate-limit.ts",
    "../lib/api/mock.ts",
    "../lib/wallet/address.ts",
    "../lib/wallet/config.ts",
    "../lib/wallet/connectors.ts",
    "../lib/wallet/siwe-session.ts",
    "../lib/config.ts",
    "../lib/features.ts",
    "../components/feature-gate.tsx",
    "../components/wallet/address-text.tsx",
    "../components/nav.tsx",
    "../app/[communitySlug]/admin/analytics/page.tsx",
    "../app/[communitySlug]/admin/members/page.tsx",
    "../app/[communitySlug]/resources/[resourceId]/page.tsx",
    "../app/[communitySlug]/resources/[resourceId]/error.tsx",
    "../app/[communitySlug]/resources/[resourceId]/loading.tsx",
    "../components/gated.tsx",
    "../components/resources/resource-page-skeleton.tsx",
    "../components/resources/resource-content-renderer.tsx",
    "../components/ui/api-states.tsx",
    "../components/ui/button.tsx",
    "../lib/api/index.ts",
    "../components/admin-guard.tsx",
    "../components/ui/bulk-action-toolbar.tsx",
    "../components/developer/scenario-selector.tsx",
    "../components/developer/siwe-debug-panel.tsx",
    "../components/wallet/address-text.tsx",
    "../lib/wallet/siwe-context.ts",
    "../lib/query/*.ts",
    "../types/**/*.d.ts",
    "../scripts/sync-api-types.js",
    "./*.test.ts",
    "./*.test.tsx",
    "../lib/api/live.ts",
    "../lib/api/errors.ts",
    "../lib/api/validators.ts",
    "../lib/api/mock-storage.ts",
    "../lib/api/role-removal.ts",
    "../lib/validation/policy.ts",
    "../lib/validation/profile.ts",
    "../lib/api/analytics.ts",
    "../components/analytics/*.tsx",
    "../app/analytics/*.tsx"
    "../lib/integration-client.ts",
    "../lib/integration/resilientCall.ts"
  ]
}
